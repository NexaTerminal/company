# Lead form email delivery (Phase 5). Copy to .env.local and fill in.
# Get an API key at https://resend.com
RESEND_API_KEY=

# Where lead notification emails are sent.
LEAD_TO_EMAIL=info@nexa.mk

# Verified sender in Resend (a verified domain/address).
# Defaults to Resend's test sender if unset.
LEAD_FROM_EMAIL=Company Nexa <onboarding@resend.dev>

# Sender for the visitor-facing auto-reply. The domain (mail.nexa.mk) must have
# SPF + DKIM verified in Resend or replies will land in spam.
AUTOREPLY_FROM_EMAIL=Company · Nexa <noreply@mail.nexa.mk>

# --- Admin CMS (/admin) ---
# Credentials for the article editor login.
ADMIN_USER=admin
ADMIN_PASSWORD=set-a-strong-password
# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-a-32-byte-hex-string

# Content storage driver: "fs" (write local files, for dev) or "github"
# (commit to the repo via the Contents API). Defaults to github in production,
# fs in development. Vercel's filesystem is read-only, so production MUST use github.
STORAGE_DRIVER=
# Required when STORAGE_DRIVER=github (i.e. production):
# Fine-grained PAT with Contents: read & write on the repo below.
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=NexaTerminal/company
GITHUB_BRANCH=main
